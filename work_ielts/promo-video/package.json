{
  "name": "ielts-navigator-pro-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "HyperFrames promotional video source for IELTS Navigator Pro.",
  "scripts": {
    "preview": "PATH=$(dirname $(node -e 'process.stdout.write(require(\"ffmpeg-static\"))')):$PATH hyperframes preview",
    "lint": "PATH=$(dirname $(node -e 'process.stdout.write(require(\"ffmpeg-static\"))')):$PATH hyperframes lint",
    "render": "PATH=$(dirname $(node -e 'process.stdout.write(require(\"ffmpeg-static\"))')):$PATH hyperframes render --output output/ielts-navigator-pro-promo.mp4 --fps 30 --quality standard",
    "render:zh": "PATH=$(dirname $(node -e 'process.stdout.write(require(\"ffmpeg-static\"))')):$PATH hyperframes render --output output/ielts-navigator-pro-promo-zh.mp4 --fps 30 --quality standard --variables '{\"language\":\"zh\"}'"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.4.45"
  }
}
